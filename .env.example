# Optional live adviser (policy & legal reviewer). Without a key, recorded responses are replayed.
TYPESAFE_API_KEY=
RESULTRELAY_ADVISE=1
RESULTRELAY_ADVISE_PROVIDER=jev
# Local model instead (ITU reference stack): RESULTRELAY_ADVISE_URL=http://localhost:11434/v1  RESULTRELAY_ADVISE_MODEL=qwen2.5:14b
# RESULTRELAY_API_KEY=   # set to require X-API-Key on every request

# --- Multi-agent council (network, health, reviewer agents + coordinator), any provider ---
# RESULTRELAY_AGENT_PROVIDER=mistral        # ollama | mistral | openai | jev | replay
# MISTRAL_API_KEY=                           # for mistral (hosted outside the UAE: synthetic SYN-* cases only)
# RESULTRELAY_AGENT_MODEL=mistral-small-latest
# RESULTRELAY_AGENT_PROVIDER=ollama          # local: RESULTRELAY_AGENT_MODEL=qwen2.5:14b (ITU reference model)
# RESULTRELAY_AGENT_URL=                     # for openai-compatible servers (vLLM, LM Studio, Azure ...)
# RESULTRELAY_AGENT_STEPS=actions            # actions (decision points) | all
# Per-role models (recommended: Mistral agents, Jev critic and coordinator):
# RESULTRELAY_CRITIC_PROVIDER=jev
# RESULTRELAY_COORDINATOR_PROVIDER=jev
# In .env, put comments on their own lines (KEY=value only).
