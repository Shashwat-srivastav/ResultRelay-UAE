# Copy to .env (git-ignored). Comments on their own lines only: KEY=value.
# Agent council: Policy Evidence Analyst, conditional TDRA-lens analyst, adversarial reviewer.
# Without keys, `python run_demo.py` replays the recorded answers.
# MISTRAL_API_KEY=
# TYPESAFE_API_KEY=
# RESULTRELAY_AGENT_PROVIDER=mistral
# RESULTRELAY_AGENT_MODEL=ministral-14b-2512
# RESULTRELAY_REVIEWER_PROVIDER=jev
# Fully local (ITU reference stack): RESULTRELAY_AGENT_PROVIDER=ollama and RESULTRELAY_AGENT_MODEL=qwen2.5:14b
# Optional single-adviser containment demo (app/advisers): RESULTRELAY_ADVISE=1, RESULTRELAY_ADVISE_PROVIDER=jev
# RESULTRELAY_API_KEY=   # set to require X-API-Key on every request

# Per-role overrides: RESULTRELAY_<ANALYST|INSTITUTION|REVIEWER>_PROVIDER / _MODEL / _URL
# RESULTRELAY_AGENT_STEPS=actions   (decision points) | all
